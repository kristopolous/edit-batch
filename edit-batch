            from boogu.models.transformers.transformer_boogu import BooguImageTransformer2DModel
            from boogu.pipelines.boogu.pipeline_boogu_turbo import BooguImageTurboPipeline

            # Register BooguImageTransformer2DModel in diffusers so from_single_file
            # can find it (it checks `issubclass(cls, getattr(diffusers, key))` for
            # every key in SINGLE_FILE_LOADABLE_CLASSES).
            import diffusers as _diffusers
            _diffusers.BooguImageTransformer2DModel = BooguImageTransformer2DModel
            from diffusers.loaders.single_file_model import SINGLE_FILE_LOADABLE_CLASSES

            # Custom converter for Boogu-Edit-Turbo GGUF.
            # Based on Lumina2's converter but with correct QKV split dimensions
            # (hidden_size=3360, num_heads=28, num_kv_heads=7 → [3360, 840, 840]).
            _BOOGU_HEAD_DIM = 3360 // 28
            _BOOGU_Q_DIM = 3360
            _BOOGU_KV_DIM = _BOOGU_HEAD_DIM * 7

            def _convert_boogu_to_diffusers(checkpoint, **kw):
                ck = {}
                checkpoint.pop("norm_final.weight", None)
                keys = list(checkpoint.keys())
                for k in keys:
                    if "model.diffusion_model." in k:
                        checkpoint[k.replace("model.diffusion_model.", "")] = checkpoint.pop(k)

                KEY_MAP = {
                    "cap_embedder": "time_caption_embed.caption_embedder",
                    "t_embedder.mlp.0": "time_caption_embed.timestep_embedder.linear_1",
                    "t_embedder.mlp.2": "time_caption_embed.timestep_embedder.linear_2",
                    "attention": "attn",
                    ".out.": ".to_out.0.",
                    "k_norm": "norm_k",
                    "q_norm": "norm_q",
                    "w1": "linear_1",
                    "w2": "linear_2",
                    "w3": "linear_3",
                    "adaLN_modulation.1": "norm1.linear",
                }
                NORM_MAP = {
                    "attention_norm1": "norm1.norm",
                    "attention_norm2": "norm2",
                }
                CR_MAP = {
                    "context_refiner.0.attention_norm1": "context_refiner.0.norm1",
                    "context_refiner.0.attention_norm2": "context_refiner.0.norm2",
                    "context_refiner.1.attention_norm1": "context_refiner.1.norm1",
                    "context_refiner.1.attention_norm2": "context_refiner.1.norm2",
                }
                FINAL_MAP = {
                    "final_layer.adaLN_modulation.1": "norm_out.linear_1",
                    "final_layer.linear": "norm_out.linear_2",
                }

                def _split_qkv(tensor, dk):
                    q, k, v = torch.split(tensor, [_BOOGU_Q_DIM, _BOOGU_KV_DIM, _BOOGU_KV_DIM], dim=0)
                    return {dk.replace("qkv", "to_q"): q, dk.replace("qkv", "to_k"): k, dk.replace("qkv", "to_v"): v}

                for key in keys:
                    dk = key
                    for pat, repl in CR_MAP.items():
                        dk = dk.replace(pat, repl)
                    for pat, repl in FINAL_MAP.items():
                        dk = dk.replace(pat, repl)
                    for pat, repl in NORM_MAP.items():
                        dk = dk.replace(pat, repl)
                    for pat, repl in KEY_MAP.items():
                        dk = dk.replace(pat, repl)
                    if "qkv" in dk:
                        ck.update(_split_qkv(checkpoint.pop(key), dk))
                    else:
                        ck[dk] = checkpoint.pop(key)
                return ck

            if "BooguImageTransformer2DModel" not in SINGLE_FILE_LOADABLE_CLASSES:
                SINGLE_FILE_LOADABLE_CLASSES["BooguImageTransformer2DModel"] = {
                    "checkpoint_mapping_fn": _convert_boogu_to_diffusers,
                    "default_subfolder": "transformer",
                }

            print(f"Loading Boogu-Image-0.1-Edit-Turbo pipeline with GGUF ...", file=sys.stderr)
            t0 = time.time()
            gguf_transformer = BooguImageTransformer2DModel.from_single_file(
                str(gguf_cache),
                quantization_config=GGUFQuantizationConfig(compute_dtype=torch.bfloat16),
                torch_dtype=torch.bfloat16,
                config=BOOGU_EDIT_TURBO_MODEL,
                subfolder="transformer",
            )
            from diffusers import AutoencoderKL, FlowMatchEulerDiscreteScheduler
            from transformers import Qwen3VLForConditionalGeneration, Qwen3VLProcessor

            vae = AutoencoderKL.from_pretrained(BOOGU_EDIT_TURBO_MODEL, subfolder="vae", torch_dtype=torch.bfloat16)
            scheduler = FlowMatchEulerDiscreteScheduler.from_pretrained(BOOGU_EDIT_TURBO_MODEL, subfolder="scheduler")
            from transformers import BitsAndBytesConfig as _BNB
            _bnb_cfg = _BNB(load_in_4bit=True, bnb_4bit_compute_dtype=torch.bfloat16)
            mllm = Qwen3VLForConditionalGeneration.from_pretrained(
                BOOGU_EDIT_TURBO_MODEL, subfolder="mllm",
                torch_dtype=torch.bfloat16,
                quantization_config=_bnb_cfg,
                device_map="auto",
            )
            processor = Qwen3VLProcessor.from_pretrained(BOOGU_EDIT_TURBO_MODEL, subfolder="processor")

            pipe = BooguImageTurboPipeline(
                transformer=gguf_transformer.to("cuda"),
                vae=vae,
                scheduler=scheduler,
                mllm=mllm,
                processor=processor,
            )
            pipe.enable_model_cpu_offload()
            t1 = time.time()
            print(f"Boogu-Edit-Turbo GGUF model ready in {t1 - t0:.1f}s", file=sys.stderr)
            # DMD turbo inference uses no CFG — set guidance scales to 1.0
            if args.text_guidance_scale == 5.0 and args.image_guidance_scale == 1.0:
                print("DMD turbo: overriding text_guidance_scale to 1.0 (use --text-guidance-scale to override)", file=sys.stderr)
                args.text_guidance_scale = 1.0
    elif args.model == "qwen-image-2.1":
        try:
            from diffusers import QwenImage21Pipeline
        except ImportError:
            print("Error: --model qwen-image-2.1 requires a diffusers release with QwenImage21Pipeline", file=sys.stderr)
            print("       (merged upstream in PR #14804; not yet in pip releases).", file=sys.stderr)
            print("       Install: pip install -U 'git+https://github.com/huggingface/diffusers'", file=sys.stderr)
            sys.exit(1)
        import transformers as _qtf
        try:
            _qver = tuple(int(p) for p in _qtf.__version__.split(".")[:2])
        except Exception:
            _qver = (0, 0)
        if _qver < QWEN21_MIN_TRANSFORMERS:
            print(f"Error: --model qwen-image-2.1 requires transformers>={'.'.join(map(str, QWEN21_MIN_TRANSFORMERS))} (found {_qtf.__version__}).", file=sys.stderr)
            print("       Install: pip install -U 'transformers>=5.17'", file=sys.stderr)
            sys.exit(1)
        print(f"Loading {QWEN21_MODEL} ...", file=sys.stderr)
        t0 = time.time()
        pipe = QwenImage21Pipeline.from_pretrained(QWEN21_MODEL, torch_dtype=torch.bfloat16)
        pipe.enable_model_cpu_offload()
        t1 = time.time()
        print(f"Qwen-Image-2.1 model ready in {t1 - t0:.1f}s", file=sys.stderr)
    elif args.skeleton:
        from transformers import AutoModel, AutoTokenizer
        print(f"Loading ControlNet pipeline with {args.controlnet} ...", file=sys.stderr)
        t0 = time.time()
        controlnet = FluxControlNetModel.from_pretrained(
            args.controlnet,
            torch_dtype=torch.bfloat16,
            variant="fp16",
        )
        text_encoder = None
        tokenizer = None
        if args.nsfw:
            text_encoder = AutoModel.from_pretrained(
                NSFW_TEXT_ENCODER, torch_dtype=torch.bfloat16
            )
            tokenizer = AutoTokenizer.from_pretrained(NSFW_TEXT_ENCODER)
        pipe = FluxControlNetPipeline.from_pretrained(
            CONTROLNET_BASE_MODEL,
            controlnet=controlnet,
            text_encoder=text_encoder,
            tokenizer=tokenizer,
            torch_dtype=torch.bfloat16,
        )
        if args.exact:
            pipe.load_lora_weights(EXACT_LORA)
        if args.nsfw:
            lora_path = args.nsfw_lora if args.nsfw_lora else NSFW_LORA
            if lora_path.startswith('http'):
                filename = lora_path.split('/')[-1].split('?')[0] or 'lora.safetensors'
                cached = LORA_CACHE_DIR / filename
                if not cached.exists():
                    download_file(lora_path, cached)
                lora_path = str(cached)
            print(f"Loading NSFW LoRA: {lora_path} (strength: {args.lora_strength})", file=sys.stderr)
            pipe.load_lora_weights(lora_path, adapter_name="nsfw_lora")
            pipe.set_adapters(["nsfw_lora"], adapter_weights=[args.lora_strength])
        pipe.enable_model_cpu_offload()
        pipe.enable_vae_tiling()
        t1 = time.time()
        print(f"ControlNet pipeline ready in {t1 - t0:.1f}s", file=sys.stderr)
        skeleton_cache = {}
    else:
        from transformers import AutoModel, AutoTokenizer
        print(f"Loading GGUF {args.gguf} ...", file=sys.stderr)
        t0 = time.time()
        transformer = Flux2Transformer2DModel.from_single_file(
            args.gguf,
            quantization_config=GGUFQuantizationConfig(compute_dtype=torch.bfloat16),
            torch_dtype=torch.bfloat16,
            config=BASE_MODEL,
            subfolder="transformer"
        )
        pipe_kwargs = dict(transformer=transformer, torch_dtype=torch.bfloat16)
        if args.nsfw:
            pipe_kwargs["text_encoder_2"] = AutoModel.from_pretrained(NSFW_TEXT_ENCODER, torch_dtype=torch.bfloat16)
            pipe_kwargs["tokenizer_2"] = AutoTokenizer.from_pretrained(NSFW_TEXT_ENCODER)
        pipe = Flux2KleinPipeline.from_pretrained(BASE_MODEL, **pipe_kwargs)
        if args.exact:
            pipe.load_lora_weights(EXACT_LORA)
        if args.nsfw:
            lora_path = args.nsfw_lora if args.nsfw_lora else NSFW_LORA
            if lora_path.startswith('http'):
                filename = lora_path.split('/')[-1].split('?')[0] or 'lora.safetensors'
                cached = LORA_CACHE_DIR / filename
                if not cached.exists():
                    download_file(lora_path, cached)
                lora_path = str(cached)
            print(f"Loading NSFW LoRA: {lora_path} (strength: {args.lora_strength})", file=sys.stderr)
            pipe.load_lora_weights(lora_path, adapter_name="nsfw_lora")
            pipe.set_adapters(["nsfw_lora"], adapter_weights=[args.lora_strength])
        pipe.enable_model_cpu_offload()
        t1 = time.time()
        print(f"Model ready in {t1 - t0:.1f}s", file=sys.stderr)
        skeleton_cache = None

    if args.input_glob:
        input_files = sorted(glob(args.input_glob))
        if args.shuf:
            import random
            random.shuffle(input_files)
        if not input_files:
            print(f"Error: input glob '{args.input_glob}' matched no files", file=sys.stderr)
            sys.exit(1)
        total = len(input_files)
    else:
        input_files = [None]
        total = 1

    if args.skeleton and args.skeleton_image:
        if any(c in args.skeleton_image for c in '*?['):
            skeleton_files = sorted(glob(args.skeleton_image))
            if not skeleton_files:
                print(f"Error: skeleton glob '{args.skeleton_image}' matched no files", file=sys.stderr)
                sys.exit(1)
        else:
            skeleton_files = [args.skeleton_image]

    oldprompt = None
    refs = []  # unused, kept for compatibility; ref_slots/ref_images used instead
    ref_file_content = ""
    ref_file_images = []
    cum_outs = []
    count = args.count
    for i, inpath in enumerate(input_files):
        cum_outs.clear()
        for c in range(count):
            t_start = time.time()
            print(f"[{c+1}/{count}] {inpath or 'no-input'}", file=sys.stderr)

            if inpath:
                stem = Path(inpath).stem
                if count > 1:
                  outpath = out_dir / f"{stem}-{c}.png"
                else:
                  outpath = out_dir / f"{stem}.png"

                if args.nc and os.path.exists(outpath):
                  print(f"skip (exists): {outpath}", file=sys.stderr)
                  continue

                try:
                    input_image = load_image(inpath)
                except Exception as e:
                    print(f"Error loading {inpath}: {e}, skipping", file=sys.stderr)
                    continue

                w, h = input_image.size
            else:
                w, h = 1024, 1024
                input_image = None
                outpath = out_dir / f"output-{c}.png"

            orig_w, orig_h = w, h

            if args.width and args.height:
                w, h = args.width, args.height
            elif args.width:
                w = args.width
                if args.ratio:
                    try:
                        rw, rh = map(int, args.ratio.split(':', 1))
                    except (ValueError, AttributeError):
                        print(f"Error: invalid ratio '{args.ratio}', expected format like '16:9'", file=sys.stderr)
                        sys.exit(1)
                    h = int(w * rh / rw)
                else:
                    h = int(w * orig_h / orig_w)
            elif args.height:
                h = args.height
                if args.ratio:
                    try:
                        rw, rh = map(int, args.ratio.split(':', 1))
                    except (ValueError, AttributeError):
                        print(f"Error: invalid ratio '{args.ratio}', expected format like '16:9'", file=sys.stderr)
                        sys.exit(1)
                    w = int(h * rw / rh)
                else:
                    w = int(h * orig_w / orig_h)
            else:
                if args.max_width or args.max_height:
                    scale = 1.0
                    if args.max_width:
                        scale = args.max_width / w
                    if args.max_height:
                        scale = min(scale, args.max_height / h)
                    w = int(w * scale)
                    h = int(h * scale)
                else:
                    w = int(w * args.scale)
                    h = int(h * args.scale)

                if args.ratio:
                    try:
                        rw, rh = map(int, args.ratio.split(':', 1))
                    except (ValueError, AttributeError):
                        print(f"Error: invalid ratio '{args.ratio}', expected format like '16:9'", file=sys.stderr)
                        sys.exit(1)
                    target = rw / rh
                    if w / h > target:
                        h = int(w / target)
                    else:
                        w = int(h * target)

                if args.max_width and w > args.max_width:
                    scale = args.max_width / w
                    w = int(w * scale)
                    h = int(h * scale)
                if args.max_height and h > args.max_height:
                    scale = args.max_height / h
                    w = int(w * scale)
                    h = int(h * scale)

            with open(args.prompt) as f:
                all = f.readlines()

                prompt = all[args.offset].strip()
                if prompt[0] == '#':
                    continue

            prompt, inline_ref_paths = extract_refs(prompt)
            prompt, inline_ratio = extract_ratio(prompt)
            prompt, inline_steps = extract_steps(prompt)
            if inline_ratio:
                args.ratio = inline_ratio
                print(f"Inline ratio: {inline_ratio}", file=sys.stderr)
            if inline_steps is not None:
                args.steps = inline_steps
                print(f"Inline steps: {inline_steps}", file=sys.stderr)
            inline_ref_images = []
            for rp in inline_ref_paths:
                try:
                    inline_ref_images.append(load_image(rp))
                except Exception as e:
                    print(f"Error loading inline ref {rp}: {e}, skipping", file=sys.stderr)
            if inline_ref_images:
                print(f"Inline refs: {', '.join(inline_ref_paths)}", file=sys.stderr)

            if oldprompt != prompt:
                print(f"New Prompt: {prompt}")

            if args.model == "hidream":
                image = generate_image(
                    model=hidream_model,
                    processor=processor,
                    prompt=prompt,
                    height=h & ~(HIDREAM_PATCH - 1),
                    width=w & ~(HIDREAM_PATCH - 1),
                    num_inference_steps=hidream_steps,
                    guidance_scale=hidream_guidance,
                    shift=hidream_shift,
                    timesteps_list=hidream_timesteps,
                    scheduler_name=hidream_scheduler,
                    seed=args.seed,
                )
                write_image(image, outpath, prompt, args.seed)
                if args.cumulative:
                    cum_outs.append(image)
                elapsed = time.time() - t_start
                print(f"{elapsed:.1f}s -> {outpath}", file=sys.stderr)
                continue

            if args.model == "boogu":
                generator = torch.Generator(device=args.device).manual_seed(args.seed)
                pipe_kwargs = dict(
                    instruction=prompt,
                    height=h,
                    width=w,
                    num_inference_steps=args.steps,
                    text_guidance_scale=args.text_guidance_scale,
                    image_guidance_scale=args.image_guidance_scale,
                    generator=generator,
                    output_type="pil",
                )
                refs_for_boogu = []
                if input_image is not None:
                    refs_for_boogu.append(input_image)
                if args.cumulative:
                    refs_for_boogu.extend(cum_outs)
                if inline_ref_images:
                    refs_for_boogu.extend(inline_ref_images)
                if refs_for_boogu:
                    pipe_kwargs["input_images"] = [refs_for_boogu]
                result = pipe(**pipe_kwargs)
                image = result.images[0]
                write_image(image, outpath, prompt, args.seed)
                if args.cumulative:
                    cum_outs.append(image)
                elapsed = time.time() - t_start
                print(f"{elapsed:.1f}s -> {outpath}", file=sys.stderr)
                continue

            if args.model == "qwen-image-2.1":
                if not (args.width or args.height or args.max_width or args.max_height):
                    if max(w, h) > QWEN21_DEFAULT_MAX_SIDE:
                        _clamp = QWEN21_DEFAULT_MAX_SIDE / max(w, h)
                        w, h = int(w * _clamp), int(h * _clamp)
                        print(f"Qwen-Image-2.1: clamped output to {w}x{h} (max side {QWEN21_DEFAULT_MAX_SIDE}; use -w/-h or --max-width/--max-height to raise)", file=sys.stderr)
                qwen_steps = args.steps if args.steps != 4 else QWEN21_DEFAULT_STEPS
                generator = torch.Generator(device=args.device).manual_seed(args.seed)
                pipe_kwargs = dict(
                    prompt=prompt,
                    height=h,
                    width=w,
                    num_inference_steps=qwen_steps,
                    generator=generator,
                    output_type="pil",
                )
                refs_for_qwen = []
                if input_image is not None:
                    refs_for_qwen.append(input_image)
                if args.ref_file:
                    ref_file_content, ref_file_images = _read_ref_file(
                        args.ref_file, ref_file_content, ref_file_images
                    )
                    refs_for_qwen.extend(ref_file_images)
                if ref_slots:
                    slot_idx = i % len(ref_slots)
                    inner_idx = i // len(ref_slots) % len(ref_slots[slot_idx])
                    refs_for_qwen.append(ref_images[slot_idx][inner_idx])
                if args.cumulative:
                    refs_for_qwen.extend(cum_outs)
                if inline_ref_images:
                    refs_for_qwen.extend(inline_ref_images)
                if len(refs_for_qwen) > QWEN21_MAX_CONDITION_IMAGES:
                    print(f"Qwen-Image-2.1 supports up to {QWEN21_MAX_CONDITION_IMAGES} reference images; got {len(refs_for_qwen)}, truncating", file=sys.stderr)
                    refs_for_qwen = refs_for_qwen[:QWEN21_MAX_CONDITION_IMAGES]
                if refs_for_qwen:
                    pipe_kwargs["image"] = refs_for_qwen[0] if len(refs_for_qwen) == 1 else refs_for_qwen
                if refs_for_qwen or args.output_resolution != QWEN21_DEFAULT_MAX_SIDE:
                    pipe_kwargs["output_resolution"] = args.output_resolution
                result = pipe(**pipe_kwargs)
                image = result.images[0]
                write_image(image, outpath, prompt, args.seed)
                if args.cumulative:
                    cum_outs.append(image)
                elapsed = time.time() - t_start
                print(f"{elapsed:.1f}s -> {outpath}", file=sys.stderr)
                continue

            if args.skeleton:
                if args.skeleton_image:
                    skel_path = skeleton_files[i] if i < len(skeleton_files) else skeleton_files[-1]
                    ctrl_img = load_image(skel_path).convert('L')
                    if input_image is None:
                        w, h = ctrl_img.size
                    control_image = ctrl_img.resize((w & ~0xf, h & ~0xf))
                else:
                    if inpath and inpath in skeleton_cache:
                        control_image = skeleton_cache[inpath]
                    else:
                        landmarks = extract_pose(input_image)
                        if landmarks:
                            if args.skeleton_mode == "skeleton":
                                control_image = render_skeleton(input_image, landmarks).convert('L')
                            elif args.skeleton_mode == "edges":
                                control_image = render_skeleton(input_image, landmarks)
                                control_image = apply_canny(control_image)
                            elif args.skeleton_mode == "canny":
                                control_image = apply_canny(input_image)
                            else:
                                control_image = render_skeleton(input_image, landmarks)
                                control_image = apply_canny(control_image)
                            control_image = control_image.resize((w & ~0xf, h & ~0xf))
                            if inpath:
                                skeleton_cache[inpath] = control_image
                        else:
                            print(f"No pose detected in {inpath}, falling back to canny edge detection", file=sys.stderr)
                            control_image = apply_canny(input_image).resize((w & ~0xf, h & ~0xf))

                gen_kwargs = {
                    "prompt": prompt,
                    "control_image": control_image,
                    "controlnet_conditioning_scale": args.skeleton_strength,
                    "height": h & ~0xf,
                    "width": w & ~0xf,
                    "num_inference_steps": args.steps,
                    #"guidance_scale": 3.5,
                }
                result = pipe(**gen_kwargs)
            else:
                gen_kwargs = {
                    "prompt": prompt,
                    "height": h & ~0xf,
                    "width": w & ~0xf,
                    "num_inference_steps": args.steps,
                }

                if args.input_glob:
                    if args.ref_file or len(cum_outs) or inline_ref_images:
                        if args.ref_file:
                            with open(args.ref_file) as f:
                              content = f.read()
                            if content != ref_file_content:
                              ref_paths = [line.strip() for line in content.splitlines() if line.strip()]
                              ref_file_images = []
                              for r in ref_paths:
                                  try:
                                      ref_file_images.append(load_image(r))
                                  except Exception as e:
                                      print(f"Error loading ref {r}: {e}, skipping", file=sys.stderr)
                              ref_file_content = content
                              print(f"New references: {', '.join(ref_paths)}")
                        iter_refs = ref_file_images + cum_outs + inline_ref_images
                    else:
                        iter_refs = None

                    if iter_refs:
                        ref = iter_refs[i % len(iter_refs)]
                        gen_kwargs['image'] = [input_image, ref]
                    elif ref_slots:
                        slot_idx = i % len(ref_slots)
                        inner_idx = i // len(ref_slots) % len(ref_slots[slot_idx])
                        gen_kwargs['image'] = [input_image, ref_images[slot_idx][inner_idx]]
                    else:
                        gen_kwargs['image'] = input_image

            oldprompt=prompt

            if not args.skeleton:
                result = pipe(**gen_kwargs)
            image = result.images[0]

            write_image(image, outpath, prompt, args.seed)
            if args.cumulative:
                cum_outs.append(image)

            elapsed = time.time() - t_start
            print(f"{elapsed:.1f}s -> {outpath}", file=sys.stderr)

    print(f"Done. {total} images saved to {out_dir}", file=sys.stderr)


if __name__ == "__main__":
    main()
