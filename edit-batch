def write_image(image, outpath, prompt, seed):
    meta = json.dumps({"prompt": prompt, "seed": seed}, ensure_ascii=False)
    ext = Path(outpath).suffix.lower()
    if ext == ".png":
        pnginfo = PngInfo()
        pnginfo.add_text("Description", meta)
        image.save(outpath, pnginfo=pnginfo)
    else:
        image.save(outpath, comment=meta)

def download_file(url, dest):
    import subprocess
    print(f"Downloading {url}...", file=sys.stderr)
    result = subprocess.run(['curl', '-L', '-s', '-o', str(dest), url], capture_output=True, text=True)
    if result.returncode != 0:
        raise RuntimeError(f"Failed to download {url}: {result.stderr}")

def extract_refs(prompt):
    """Extract ref:<path> tokens from a prompt string.

    Returns (cleaned_prompt, [list of path strings]).
    """
    paths = re.findall(r'ref:(\S+)', prompt)
    cleaned = re.sub(r'\s*ref:\S+', '', prompt).strip()
    return cleaned, paths

def extract_ratio(prompt):
    """Extract ratio:<W>:<H> token from a prompt string.

    Returns (cleaned_prompt, ratio_string or None).
    """
    match = re.search(r'ratio:(\d+:\d+)', prompt)
    if match:
        ratio = match.group(1)
        cleaned = re.sub(r'\s*ratio:\S+', '', prompt).strip()
        return cleaned, ratio
    return prompt, None

def extract_steps(prompt):
    """Extract steps:<int> token from a prompt string.

    Returns (cleaned_prompt, steps_int or None).
    """
    match = re.search(r'steps:(\d+)', prompt)
    if match:
        steps = int(match.group(1))
        cleaned = re.sub(r'\s*steps:\S+', '', prompt).strip()
        return cleaned, steps
    return prompt, None

