    def _read_ref_file(path, prev_content, prev_images):
        """Re-read a reference-image file; reload images only when content changes."""
        with open(path) as f:
            content = f.read()
        if content == prev_content:
            return prev_content, prev_images
        images = []
        for r in (line.strip() for line in content.splitlines() if line.strip()):
            try:
                images.append(load_image(r))
            except Exception as e:
                print(f"Error loading ref {r}: {e}, skipping", file=sys.stderr)
        print(f"New references: {', '.join(line.strip() for line in content.splitlines() if line.strip())}")
        return content, images

